<ui:FluentWindow x:Class="Warhorse.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Warhorse.ViewModels"
                 Title="Text Reader" Height="500" Width="800"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Text Reader" />

        <!-- Start screen: pick a text source -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenFileCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Document24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Open File" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenUrlCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="From URL" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenRandomCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Wand24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Random Text" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <!-- Reader: shown once a source is loaded -->
        <Grid Grid.Row="1" Margin="16,0,16,16"
              Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                           Content="Close" Command="{Binding CloseCommand}" />
                <ui:TextBlock Text="{Binding SourceName}" FontTypography="Subtitle"
                              VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ui:TextBox Grid.Row="1" Text="{Binding Text, Mode=OneWay}"
                        IsReadOnly="True" AcceptsReturn="True"
                        TextWrapping="Wrap" VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</ui:FluentWindow>
