<ui:FluentWindow x:Class="Warhorse.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Warhorse.ViewModels"
                 Title="Text Reader" Height="500" Width="800"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Text Reader" />

        <!-- Start screen: pick a text source -->
        <StackPanel x:Name="StartButtons" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowStartButtons, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenFileCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Document24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Open File" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenUrlCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="From URL" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <ui:Button Style="{StaticResource VerticalIconButton}"
                       Command="{Binding OpenRandomCommand}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Wand24" FontSize="28"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Random Text" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <!-- Reader: shown once a source is loaded -->
        <Grid Grid.Row="1" Margin="16,0,16,16"
              Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                           Content="Close" Command="{Binding CloseCommand}" />
                <ui:TextBlock DockPanel.Dock="Right" Margin="0,0,12,0"
                              Text="{Binding LineCount, StringFormat={}{0:N0} lines}"
                              Appearance="Secondary" VerticalAlignment="Center" />
                <ui:TextBlock Text="{Binding SourceName}" FontTypography="Subtitle"
                              VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!--
                Item virtualization keeps only the visible lines realized, and the
                bound list reads those lines from disk, so GUI memory is independent
                of document size. Pixel scroll unit keeps dragging the scrollbar and
                PgUp/PgDn smooth instead of snapping line by line.
            -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Lines}"
                     FontFamily="Consolas" FontSize="13"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneTime}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Inline URL prompt -->
        <Border Grid.Row="1" Background="#80000000"
                Visibility="{Binding IsUrlPromptOpen, Converter={StaticResource BoolToVisibility}}">
            <ui:Card Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ui:TextBlock Text="Address of a text file or page"
                                  FontTypography="BodyStrong" Margin="0,0,0,8" />

                    <ui:TextBox x:Name="UrlTextBox"
                                Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://example.com/text.txt"
                                IsVisibleChanged="UrlTextBox_IsVisibleChanged">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitUrlCommand}" />
                            <KeyBinding Key="Esc" Command="{Binding CancelUrlPromptCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ui:TextBlock Text="Enter a valid http or https address."
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding HasUrlError, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="Open" Appearance="Primary" Width="90"
                                   Command="{Binding SubmitUrlCommand}" />
                        <ui:Button Content="Cancel" Width="90" Margin="8,0,0,0"
                                   Command="{Binding CancelUrlPromptCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="1" Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing Progress="{Binding ProgressPercent}"
                                 HorizontalAlignment="Center" />
                <ui:TextBlock Text="{Binding ProgressPercent, StringFormat={}Indexing… {0:N0}%}"
                              Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
